generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AUTHOR
  ADMIN
}

enum BookStatus {
  DRAFT
  IN_PRODUCTION
  PUBLISHED
  OUT_OF_STOCK
  DISCONTINUED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum RoyaltyTransactionType {
  EARNING
  PAYMENT
  ADJUSTMENT
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  role     UserRole @default(AUTHOR)
  isActive Boolean  @default(true)

  books               Book[]
  tickets             SupportTicket[]
  assignedTickets     SupportTicket[]      @relation("TicketAssignee")
  messages            TicketMessage[]
  royaltyTransactions RoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokenVersion Int @default(0)

  @@index([role, isActive])
  @@map("users")
}

model Book {
  id              String     @id @default(cuid())
  authorId        String
  title           String
  isbn            String?    @unique
  genre           String?
  publicationDate DateTime?
  status          BookStatus @default(DRAFT)
  mrp             Decimal?   @db.Decimal(10, 2)
  currency        String     @default("INR")

  author              User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  royaltyTransactions RoyaltyTransaction[]
  tickets             SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, status])
  @@index([title])
}

model RoyaltyTransaction {
  id          String                 @id @default(cuid())
  authorId    String
  bookId      String
  type        RoyaltyTransactionType
  amount      Decimal                @db.Decimal(12, 2)
  currency    String                 @default("INR")
  reference   String?
  description String?
  occurredAt  DateTime               @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  book   Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([authorId, occurredAt])
  @@index([bookId, occurredAt])
  @@index([type, occurredAt])
}

model SupportTicket {
  id           String  @id @default(cuid())
  ticketNumber String  @unique @default(cuid())
  authorId     String
  bookId       String?
  assigneeId   String?

  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  category    TicketCategory @default(GENERAL_INQUIRY)
  priority    TicketPriority @default(MEDIUM)

  resolvedAt DateTime?
  closedAt   DateTime?

  author   User  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  book     Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  messages      TicketMessage[]
  aiAnalyses    TicketAIAnalysis[]
  statusHistory TicketStatusHistory[]
  attachments   TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([status, priority, createdAt])
  @@index([category, status])
  @@index([assigneeId, status])
}

model TicketMessage {
  id         String            @id @default(cuid())
  ticketId   String
  senderId   String
  body       String            @db.Text
  visibility MessageVisibility @default(PUBLIC)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@index([senderId])
}

model TicketAIAnalysis {
  id               String         @id @default(cuid())
  ticketId         String
  model            String
  promptVersion    String
  category         TicketCategory
  priority         TicketPriority
  confidence       Decimal?       @db.Decimal(5, 4)
  draftResponse    String?        @db.Text
  inputTokens      Int?
  outputTokens     Int?
  processingStatus String         @default("COMPLETED")
  errorMessage     String?
  createdAt        DateTime       @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketStatusHistory {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  note        String?
  createdAt   DateTime      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  fileName   String
  mimeType   String
  sizeBytes  Int?
  storageKey String?
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
